# ============================================================
# SARC 2 - Variáveis de ambiente compartilhadas (docker-compose)
# Copie este arquivo para ".env" e ajuste os valores antes de subir o ambiente.
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=sarc2
MYSQL_PASSWORD=sarc2password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---- JWT (compartilhado entre api-gateway e auth-service) ----
JWT_SECRET=troque-este-segredo-em-producao-para-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=8h

# ---- Chave compartilhada para rotas /internal/* (comunicação serviço-a-serviço) ----
INTERNAL_API_KEY=troque-esta-chave-interna-em-producao

# ---- Seed do administrador inicial (auth-service) ----
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@sarc2.local
SEED_ADMIN_PASSWORD=Admin@12345

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Portas expostas no host ----
FRONTEND_PORT=5173
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
PROFESSOR_SERVICE_PORT=3002
SALA_SERVICE_PORT=3003
EQUIPAMENTO_SERVICE_PORT=3004
RESERVA_SERVICE_PORT=3005
CONSULTA_SERVICE_PORT=3006
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300

# ---- CORS (origem permitida para o frontend) ----
CORS_ORIGIN=http://localhost:5173
