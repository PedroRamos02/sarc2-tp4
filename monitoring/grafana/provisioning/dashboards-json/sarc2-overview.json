{
  "id": null,
  "uid": "sarc2-overview",
  "title": "SARC 2 - Visão Geral",
  "tags": ["sarc2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requisições HTTP por serviço (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tempo médio de resposta (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum[1m])) by (service) / sum(rate(http_request_duration_seconds_count[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Erros HTTP (>=500) por serviço",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_errors_total[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Falhas de proxy no gateway",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(gateway_proxy_errors_total[1m])) by (target)",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Uso de memória (RSS) por serviço",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum({__name__=~\".*_process_resident_memory_bytes\"}) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Uso de CPU por serviço (núcleos)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\".*_process_cpu_seconds_total\"}[1m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Reservas ativas",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "reserva_reservas_total" }]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Usuários ativos",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "auth_usuarios_total" }]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Professores ativos",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "professor_professores_total" }]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Espaços ativos (salas + laboratórios)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(sala_espacos_total)" }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Conflitos de reserva rejeitados (por tipo)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(reserva_conflitos_total[5m])) by (tipo)",
          "legendFormat": "{{tipo}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Reservas criadas vs. canceladas",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(reserva_criadas_total[5m])", "legendFormat": "criadas" },
        { "expr": "rate(reserva_canceladas_total[5m])", "legendFormat": "canceladas" }
      ]
    }
  ]
}
